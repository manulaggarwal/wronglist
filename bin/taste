#!/usr/bin/env node
/**
 * taste — constraint files that make coding agents more correct over time.
 *
 *   taste init     scan repo → propose forbidden strings → write evals/ + CI + @-imports
 *   taste check    run the constraint grep now (exit 1 on match)
 *   taste review   print the 3-round review-chain prompt for a file
 *
 * No API keys. Everything local. Node 18+.
 */
const fs = require("fs");
const path = require("path");
const { execSync } = require("child_process");

const ARGS = process.argv.slice(2);
const CMD = ARGS[0] || "help";

/* ---------- helpers ---------- */

function findRepoRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  while (true) {
    if (fs.existsSync(path.join(dir, ".git"))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) return process.cwd();
    dir = parent;
  }
}

function readIfExists(p) {
  try { return fs.readFileSync(p, "utf8"); } catch { return null; }
}

function log(s = "") { console.log(s); }

/* ---------- shared proposal engine ---------- */

// Heuristics: scan README + recent commits + biggest text files for
// suspicious literals. Proposes candidates; human edits the file after.
function proposeForbiddenStrings(root) {
  const candidates = new Map(); // string -> reason
  const add = (s, why) => { if (s && s.length >= 4 && !candidates.has(s)) candidates.set(s, why); };

  // 1. README smoke
  const readme = readIfExists(path.join(root, "README.md")) || readIfExists(path.join(root, "readme.md")) || "";
  for (const m of readme.matchAll(/\b(TODO|FIXME|XXX|HACK)\b/g)) add(m[1], "found in README");
  if (/lorem ipsum/i.test(readme)) add("Lorem ipsum", "placeholder text in README");
  if (/TBD\b/.test(readme)) add("TBD", "TBD in README");

  // 2. Recent commit messages (last 50)
  try {
    const log = execSync("git log --oneline -50", { cwd: root, encoding: "utf8", stdio: ["pipe", "pipe", "pipe"] });
    for (const m of log.matchAll(/\b(typo|wrong|fix|broken|revert)\b/gi)) add(`# pattern: commits mention "${m[1]}" — check if a literal mistake repeats`, "commit-history signal");
  } catch {}

  // 3. Source scan for classic agent-isms (small repos only, capped)
  let scanned = 0;
  const walk = (dir) => {
    if (scanned > 200) return;
    for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
      if (e.name.startsWith(".") || ["node_modules", "dist", "build", "vendor", "__pycache__"].includes(e.name)) continue;
      const p = path.join(dir, e.name);
      if (e.isDirectory()) { walk(p); continue; }
      if (!/\.(md|txt|py|js|ts|lua|rb|go|rs|java|c|cpp|h|sh|yml|yaml|json|toml)$/.test(e.name)) continue;
      scanned++;
      const body = readIfExists(p);
      if (!body) continue;
      if (/lorem ipsum/i.test(body)) add("Lorem ipsum", `placeholder in ${path.relative(root, p)}`);
      for (const m of body.matchAll(/\b(TODO|FIXME|XXX)\b(?![^\n]*templates?)/g)) add(m[1], `found in ${path.relative(root, p)}`);
    }
  };
  walk(root);

  return [...candidates.entries()].slice(0, 12);
}

function writeConstraintFiles(root, proposals) {
  const evalsDir = path.join(root, "evals");
  fs.mkdirSync(evalsDir, { recursive: true });

  const fsPath = path.join(evalsDir, "forbidden-strings.txt");
  if (readIfExists(fsPath)) {
    log(`  ↷ evals/forbidden-strings.txt exists — leaving untouched`);
  } else {
    const lines = proposals.map(([s, why]) => `${s}   # ${why}`);
    const body = [
      "# forbidden-strings.txt — CI-greppable constraints (proposed by `taste init`)",
      "# EDIT ME: keep what's real, delete what's noise, add what you know.",
      "# Any literal line (minus comments) matching in SCOPE = FAIL.",
      "#",
      "# SCOPE: point at generated/production content, not history/docs.",
      "# Usage: taste check   (or ci/check-constraints.sh)",
      "#",
      ...lines,
      "",
    ].join("\n");
    fs.writeFileSync(fsPath, body);
    log(`  + evals/forbidden-strings.txt (${proposals.length} proposals — EDIT ME)`);
  }

  const evalsPath = path.join(evalsDir, "EVALS.md");
  if (!readIfExists(evalsPath)) {
    fs.writeFileSync(evalsPath, TEMPLATES.evals);
    log("  + evals/EVALS.md (skeleton — fill §1 with 3 golden examples)");
  } else log("  ↷ evals/EVALS.md exists — leaving untouched");

  // CI script
  const ciDir = path.join(root, "ci");
  fs.mkdirSync(ciDir, { recursive: true });
  const checkPath = path.join(ciDir, "check-constraints.sh");
  if (!readIfExists(checkPath)) {
    fs.writeFileSync(checkPath, TEMPLATES.check);
    fs.chmodSync(checkPath, 0o755);
    log("  + ci/check-constraints.sh (exit 1 on any match)");
  } else log("  ↷ ci/check-constraints.sh exists");

  // @-imports into agent context files
  for (const name of ["CLAUDE.md", "AGENTS.md", "AGENT.md"]) {
    const p = path.join(root, name);
    const cur = readIfExists(p);
    if (!cur) continue;
    if (cur.includes("@evals/forbidden-strings.txt")) { log(`  ↷ ${name} already imports constraints`); continue; }
    fs.writeFileSync(p, cur.trimEnd() + "\n\n## Always-Loaded Constraints\n\n@evals/forbidden-strings.txt\n@evals/EVALS.md\n");
    log(`  + ${name}: @-imports appended (Claude Code inlines these at session start)`);
  }
}

/* ---------- commands ---------- */

function cmdInit() {
  const root = findRepoRoot();
  log(`taste init — ${path.basename(root)}`);
  log("Scanning for constraint candidates (README, commits, sources)…\n");
  const proposals = proposeForbiddenStrings(root);
  if (!proposals.length) log("  (no obvious candidates found — templates will start empty)");
  writeConstraintFiles(root, proposals.length ? proposals : [["EXAMPLE-FORBIDDEN-STRING", "replace with a real one"]]);
  log("\nNext:");
  log("  1. EDIT evals/forbidden-strings.txt — keep only real constraints");
  log("  2. Fill evals/EVALS.md §1 with 3-5 golden examples of good output");
  log("  3. Run: taste check");
}

function cmdCheck(scopeArgs) {
  const root = findRepoRoot();
  const f = path.join(root, "evals", "forbidden-strings.txt");
  if (!readIfExists(f)) { log("No evals/forbidden-strings.txt. Run `taste init` first."); process.exit(2); }
  const scope = scopeArgs.length ? scopeArgs : ["src", "lib", "app", "content", "packs", "out", "dist", "docs"];
  const existing = scope.filter((d) => fs.existsSync(path.join(root, d)));
  if (!existing.length) { log(`No scope dirs found (looked in: ${scope.join(", ")}).\nPass paths explicitly: taste check <dir>`); process.exit(2); }
  try {
    execSync(`grep -rn -F -f "${f}" ${existing.map((d) => `"${d}"`).join(" ")} `, { cwd: root, stdio: "inherit" });
    log(`\n✓ clean — no forbidden strings in: ${existing.join(", ")}`);
  } catch (e) {
    if (e.status === 1) { log(`\n✗ FORBIDDEN STRINGS FOUND (above). Fix or move to EVALS.md §2 as a known failure.`); process.exit(1); }
    throw e;
  }
}

function cmdReview(file) {
  if (!file) { log("usage: taste review <file-or-dir>"); process.exit(2); }
  log(TEMPLATES.review.replaceAll("<TARGET>", file));
}

function cmdHelp() {
  log(`taste — constraint files that make coding agents more correct over time

  taste init            scan repo, write evals/, ci/, @-imports (EDIT AFTER)
  taste check [dirs…]   grep the forbidden strings — exit 1 on match
  taste review <file>   print the 3-round review-chain prompt for <file>

No API keys. Everything local. Templates: templates/ in the repo.`);
}

/* ---------- templates ---------- */

const TEMPLATES = {
  check: `#!/usr/bin/env bash
# check-constraints.sh — fails on any forbidden-string match.
# Usage: ./ci/check-constraints.sh [scope dirs...]   (defaults below)
set -euo pipefail
cd "$(dirname "$0")/.."
SCOPE=("\${@:-src lib app content packs out dist docs}")
existing=()
for d in "\${SCOPE[@]}"; do [ -d "$d" ] && existing+=("$d"); done
[ \${#existing[@]} -eq 0 ] && { echo "no scope dirs found"; exit 0; }
if grep -rn -F -f evals/forbidden-strings.txt "\${existing[@]}"; then
  echo "✗ FORBIDDEN STRINGS FOUND — see matches above"; exit 1
fi
echo "✓ constraints clean"
`,

  evals: `# EVALS.md — quality bars for this repo

*Evals are taste written down. Judge fuzzy outputs against this file.*

## §1 Golden examples (known-good)
### <example>
\`status: unverified · context: <situation/register>\`
<the example>
**Why it's good:** <the part an agent pattern-matches>

## §2 Known failures (must not recur)
| ❌ Pattern | Why | Correct version |
|---|---|---|
| <literal> | <one line> | <fix> |
Rule: a caught flaw lands here SAME DAY. Recording ≠ fixing — fix the source too.

## §3 Criteria (from disagreements)
| Criterion | Origin | Statement |
|---|---|---|
| <name> | <debate> | <principle> |
`,

  review: `# 3-round review chain for <TARGET>

Run these as three separate agent passes. Feed each round the prior rounds'
outputs. Enforce the ledger — it's the whole point.

ROUND 1 — ADVERSARIAL
Read <TARGET> and related files on disk. Find what's wrong, missing, or
oversold. Cite files/lines. Balance: name what's RIGHT too.
End with: WHAT THIS ROUND CONCLUDES.

ROUND 2 — CONSTRUCTIVE
Given Round 1, read <TARGET> again as a senior designer: what should this
become? Propose concrete improvements and missing mechanisms.
End with: WHAT PRIOR CONCLUSIONS THIS ROUND INVALIDATES (required).

ROUND 3 — SYNTHESIS
Given Rounds 1-2, decide: what ships, what changes, what's deferred (→
watch-list). One canonical decision record.
End with: THE LOCKED LIST + the criteria mined from disagreements (→ EVALS §3).

Rules: reviewers read real files, never trust the brief; every claim checked
against disk; human closes the loop.
`,
};

/* ---------- main ---------- */

switch (CMD) {
  case "init": cmdInit(); break;
  case "check": cmdCheck(ARGS.slice(1)); break;
  case "review": cmdReview(ARGS[1]); break;
  default: cmdHelp(); break;
}
