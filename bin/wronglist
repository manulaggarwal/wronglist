#!/usr/bin/env node
/**
 * wronglist — constraint files that make coding agents more correct over time.
 *
 *   wronglist init     scan repo → propose wronglist entries → write evals/ + CI + @-imports
 *   wronglist check    run the constraint grep now (exit 1 on match, 0 clean, 2 config)
 *   wronglist review   print the 3-round review-chain prompt for a file
 *
 * No API keys. Everything local. Node 18+.
 */
const fs = require("fs");
const path = require("path");
const os = require("os");
const { execSync, execFileSync } = require("child_process");

const ARGS = process.argv.slice(2);
const CMD = ARGS[0] || "help";

/* ---------- helpers ---------- */

function findRepoRoot(start = process.cwd()) {
  let dir = path.resolve(start);
  while (true) {
    if (fs.existsSync(path.join(dir, ".git"))) return dir;
    const parent = path.dirname(dir);
    if (parent === dir) return process.cwd();
    dir = parent;
  }
}

function readIfExists(p) {
  try { return fs.readFileSync(p, "utf8"); } catch { return null; }
}

function log(s = "") { console.log(s); }

// Strip comment lines and blanks from a wronglist file, return bare literals.
// Writes a temp pattern file in a UNIQUE dir (grep -f needs a file; parallel
// runs must never read each other's patterns — concurrency bug, fixed v0.2.1).
function effectivePatterns(wronglistPath) {
  const raw = readIfExists(wronglistPath) || "";
  const lines = raw.split("\n")
    .map((l) => l.replace(/\s+#.*$/, "").trim()) // trailing inline comments + whitespace
    .filter((l) => l !== "" && !l.startsWith("#"));
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "wronglist-"));
  const tmp = path.join(dir, "patterns.txt");
  fs.writeFileSync(tmp, lines.join("\n") + "\n");
  return { tmp, count: lines.length, dir };
}

/* ---------- proposal engine ---------- */

function proposeWronglistEntries(root) {
  const candidates = new Map(); // string -> reason
  const add = (s, why) => { if (s && s.length >= 4 && !candidates.has(s)) candidates.set(s, why); };

  // 1. README smoke
  const readme = readIfExists(path.join(root, "README.md")) || readIfExists(path.join(root, "readme.md")) || "";
  for (const m of readme.matchAll(/\b(TODO|FIXME|XXX|HACK)\b/g)) add(m[1], "found in README");
  if (/lorem ipsum/i.test(readme)) add("Lorem ipsum", "placeholder text in README");
  if (/\bTBD\b/.test(readme)) add("TBD", "TBD in README");

  // 2. Recent commit messages (last 50) — signals only, as comments
  try {
    const gitlog = execSync("git log --oneline -50", { cwd: root, encoding: "utf8", stdio: ["pipe", "pipe", "pipe"] });
    const signals = new Set();
    for (const m of gitlog.matchAll(/\b(typo|wrong|broken|revert)\b/gi)) signals.add(m[1].toLowerCase());
    if (signals.size) add(`# commit-history signal: mentions ${[...signals].join(", ")} — check if a literal mistake repeats`, "history");
  } catch {}

  // 3. Source scan for classic agent-isms (capped)
  let scanned = 0;
  const walk = (dir) => {
    if (scanned > 200) return;
    let entries;
    try { entries = fs.readdirSync(dir, { withFileTypes: true }); }
    catch { return; } // unreadable dir (EACCES etc.) — skip, don't crash
    for (const e of entries) {
      if (e.name.startsWith(".") || ["node_modules", "dist", "build", "vendor", "__pycache__"].includes(e.name)) continue;
      const p = path.join(dir, e.name);
      if (e.isDirectory()) { walk(p); continue; }
      if (!/\.(md|txt|py|js|ts|lua|rb|go|rs|java|c|cpp|h|sh|yml|yaml|json|toml)$/.test(e.name)) continue;
      scanned++;
      const body = readIfExists(p);
      if (!body) continue;
      if (/lorem ipsum/i.test(body)) add("Lorem ipsum", `placeholder in ${path.relative(root, p)}`);
      for (const m of body.matchAll(/\b(TODO|FIXME|XXX)\b/g)) add(m[1], `found in ${path.relative(root, p)}`);
    }
  };
  walk(root);

  return [...candidates.entries()].slice(0, 12);
}

function writeConstraintFiles(root, proposals) {
  const evalsDir = path.join(root, "evals");
  fs.mkdirSync(evalsDir, { recursive: true });

  const wlPath = path.join(evalsDir, "wronglist.txt");
  if (readIfExists(wlPath)) {
    log(`  ↷ evals/wronglist.txt exists — leaving untouched`);
  } else {
    const body = [
      "# wronglist.txt — CI-greppable constraints (proposed by `wronglist init`)",
      "# EDIT ME: keep what's real, delete what's noise, add what you know.",
      "# Format: one literal per line. `#`-lines and blanks are ignored;",
      "# trailing `  # reason` comments are stripped before matching.",
      "#",
      "# SCOPE: point at generated/production content, not history/docs.",
      "# Usage: wronglist check   (or ci/check-constraints.sh)",
      "#",
      ...proposals.map(([s, why]) => (s.startsWith("#") ? s : `${s}   # ${why}`)),
      "",
    ].join("\n");
    fs.writeFileSync(wlPath, body);
    log(`  + evals/wronglist.txt (${proposals.length} proposals — EDIT ME)`);
  }

  const evalsPath = path.join(evalsDir, "EVALS.md");
  if (!readIfExists(evalsPath)) {
    fs.writeFileSync(evalsPath, TEMPLATES.evals);
    log("  + evals/EVALS.md (skeleton — fill §1 with 3 golden examples)");
  } else log("  ↷ evals/EVALS.md exists — leaving untouched");

  const ciDir = path.join(root, "ci");
  fs.mkdirSync(ciDir, { recursive: true });
  const checkPath = path.join(ciDir, "check-constraints.sh");
  if (!readIfExists(checkPath)) {
    fs.writeFileSync(checkPath, TEMPLATES.check);
    fs.chmodSync(checkPath, 0o755);
    log("  + ci/check-constraints.sh (exit 1 on any match)");
  } else log("  ↷ ci/check-constraints.sh exists");

  for (const name of ["CLAUDE.md", "AGENTS.md", "AGENT.md"]) {
    const p = path.join(root, name);
    const cur = readIfExists(p);
    if (!cur) continue;
    if (cur.includes("@evals/wronglist.txt")) { log(`  ↷ ${name} already imports constraints`); continue; }
    fs.writeFileSync(p, cur.trimEnd() + "\n\n## Always-Loaded Constraints\n\n@evals/wronglist.txt\n@evals/EVALS.md\n");
    log(`  + ${name}: @-imports appended (Claude Code inlines these at session start)`);
  }
}

/* ---------- commands ---------- */

function cmdInit() {
  const root = findRepoRoot();
  log(`wronglist init — ${path.basename(root)}`);
  log("Scanning for constraint candidates (README, commits, sources)…\n");
  const proposals = proposeWronglistEntries(root);
  const real = proposals.filter(([s]) => !s.startsWith("#"));
  if (!real.length) log("  (no obvious candidates found — templates will start with one placeholder)");
  writeConstraintFiles(root, real.length ? proposals : [["REPLACE-WITH-REAL-CONSTRAINT", "replace me"]]);
  log("\nNext:");
  log("  1. EDIT evals/wronglist.txt — keep only real constraints");
  log("  2. Fill evals/EVALS.md §1 with 3-5 golden examples of good output");
  log("  3. Run: wronglist check");
}

function cmdCheck(scopeArgs) {
  const root = findRepoRoot();
  const wl = path.join(root, "evals", "wronglist.txt");
  if (!readIfExists(wl)) { log("No evals/wronglist.txt. Run `wronglist init` first."); process.exit(2); }

  const { tmp, count, dir } = effectivePatterns(wl);
  if (count === 0) { log("evals/wronglist.txt has no active entries (all comments/blanks)."); fs.rmSync(dir, { recursive: true, force: true }); process.exit(2); }

  // Default scope: generated/production content ONLY — never docs (see patterns/01).
  const defaults = ["src", "lib", "app", "content", "packs", "out", "dist"];
  const scope = scopeArgs.length ? scopeArgs : defaults;
  const existing = scope.filter((d) => fs.existsSync(path.join(root, d)));
  if (!existing.length) {
    log(`No scope dirs found (looked in: ${scope.join(", ")}).\nPass paths explicitly: wronglist check <dir>`);
    fs.rmSync(dir, { recursive: true, force: true });
    process.exit(2);
  }

  let found = false;
  try {
    // grep exits 0 = matches found (violation), 1 = none (clean).
    // execFileSync: no shell — scope args can never be interpreted as syntax.
    const out = execFileSync(
      "grep", ["-rn", "-F", "-f", tmp, ...existing],
      { cwd: root, encoding: "utf8" }
    );
    found = true;
    log(out.trimEnd());
    log(`\n✗ WRONGLIST MATCHES FOUND — fix, or record in EVALS.md §2 if it's a known failure.`);
  } catch (e) {
    if (e.status === 1) {
      log(`✓ clean — no wronglist matches in: ${existing.join(", ")}`);
    } else {
      log(`grep failed (exit ${e.status}): ${e.message}`);
      fs.rmSync(dir, { recursive: true, force: true });
      process.exit(2);
    }
  }
  fs.rmSync(dir, { recursive: true, force: true });
  if (found) process.exit(1);
}

function cmdReview(file) {
  if (!file) { log("usage: wronglist review <file-or-dir>"); process.exit(2); }
  log(TEMPLATES.review.replaceAll("<TARGET>", file));
}

function cmdHelp() {
  log(`wronglist — constraint files that make coding agents more correct over time

  wronglist init            scan repo, write evals/, ci/, @-imports (EDIT AFTER)
  wronglist check [dirs…]   grep the wronglist — exit 1 on match, 0 clean, 2 config
  wronglist review <file>   print the 3-round review-chain prompt for <file>

No API keys. Everything local. Templates: templates/ in the repo.`);
}

/* ---------- templates ---------- */

const TEMPLATES = {
  check: `#!/usr/bin/env bash
# check-constraints.sh — fails on any wronglist match.
# Usage: ./ci/check-constraints.sh [scope dirs...]   (defaults below)
set -euo pipefail
cd "$(dirname "$0")/.."
if [ $# -gt 0 ]; then SCOPE=("$@"); else SCOPE=(src lib app content packs out dist); fi
existing=()
for d in "\${SCOPE[@]}"; do [ -d "$d" ] && existing+=("$d"); done
if [ \${#existing[@]} -eq 0 ]; then echo "no scope dirs found (looked in: \${SCOPE[*]})"; exit 2; fi
# Strip comment lines + blanks + trailing comments/whitespace before matching
PATTERNS=$(mktemp)
sed -e 's/[[:space:]]#.*$//' -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' evals/wronglist.txt | grep -v -e '^[[:space:]]*$' -e '^#' > "$PATTERNS" || true
if [ ! -s "$PATTERNS" ]; then echo "wronglist has no active entries"; rm -f "$PATTERNS"; exit 2; fi
if grep -rn -F -f "$PATTERNS" "\${existing[@]}"; then
  echo "✗ WRONGLIST MATCHES FOUND — see above"; rm -f "$PATTERNS"; exit 1
fi
echo "✓ constraints clean"; rm -f "$PATTERNS"
`,

  evals: `# EVALS.md — quality bars for this repo

*Evals are taste written down. Judge fuzzy outputs against this file.*

## §1 Golden examples (known-good)
### <example>
\`status: unverified · context: <situation/register>\`
<the example>
**Why it's good:** <the part an agent pattern-matches>

## §2 Known failures (must not recur)
| ❌ Pattern | Why | Correct version |
|---|---|---|
| <literal> | <one line> | <fix> |
Rule: a caught flaw lands here SAME DAY. Recording ≠ fixing — fix the source too.

## §3 Criteria (from disagreements)
| Criterion | Origin | Statement |
|---|---|---|
| <name> | <debate> | <principle> |
`,

  review: `# 3-round review chain for <TARGET>

Run these as three separate agent passes. Feed each round the prior rounds'
outputs. Enforce the ledger — it's the whole point.

ROUND 1 — ADVERSARIAL
Read <TARGET> and related files on disk. Find what's wrong, missing, or
oversold. Cite files/lines. Balance: name what's RIGHT too.
End with: WHAT THIS ROUND CONCLUDES.

ROUND 2 — CONSTRUCTIVE
Given Round 1, read <TARGET> again as a senior designer: what should this
become? Propose concrete improvements and missing mechanisms.
End with: WHAT PRIOR CONCLUSIONS THIS ROUND INVALIDATES (required).

ROUND 3 — SYNTHESIS
Given Rounds 1-2, decide: what ships, what changes, what's deferred (→
watch-list). One canonical decision record.
End with: THE LOCKED LIST + the criteria mined from disagreements (→ EVALS §3).

Rules: reviewers read real files, never trust the brief; every claim checked
against disk; human closes the loop.
`,
};

/* ---------- main ---------- */

switch (CMD) {
  case "init": cmdInit(); break;
  case "check": cmdCheck(ARGS.slice(1)); break;
  case "review": cmdReview(ARGS[1]); break;
  default: cmdHelp(); break;
}
